{
  "folders": [
    {
      "name": "TOS [Root & Core Cargo Workspace]",
      "path": "."
    },
    {
      "name": "TOS [Face - Svelte Web UI]",
      "path": "face-svelte-ui"
    },
    {
      "name": "TOS [Face - Electron Container]",
      "path": "face-electron-any"
    },
    {
      "name": "TOS [Face - Android Flutter]",
      "path": "face-android-flutter"
    }
  ],
  "settings": {
    // --- Global Workspace Settings ---
    "files.exclude": {
      "**/target": true,
      "**/.svelte-kit": true,
      "**/build": true,
      "**/node_modules": true
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "lldb",
        "request": "launch",
        "name": "Debug TOS Brain Core",
        "program": "${workspaceFolder:TOS [Root & Core Cargo Workspace]}/target/debug/tos-brain",
        "args": ["--orchestrate"],
        "cwd": "${workspaceFolder:TOS [Root & Core Cargo Workspace]}"
      }
    ]
  }
}
